{
  "name": "guitar-note-visualizer",
  "version": "0.1.0",
  "description": "Real-time guitar note / chord visualizer",
  "scripts": {
    "postinstall": "node scripts/copy-effetune.mjs",
    "dev": "vite",
    "build": "tsc --noEmit && vite build && node scripts/copy-notices.mjs dist",
    "build:plugin": "tsc --noEmit && vite build --mode plugin && node scripts/prune-plugin-ui.mjs && node scripts/copy-notices.mjs dist-plugin",
    "notices": "node scripts/build-notices.mjs",
    "preview": "vite preview",
    "test": "vitest run"
  },
  "license": "MIT",
  "type": "module",
  "dependencies": {
    "@effetune/dsp": "^0.19.0",
    "tonal": "^6.9.0"
  },
  "devDependencies": {
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.1"
  },
  "private": true
}
